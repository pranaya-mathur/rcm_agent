# Copy to .env and fill in secrets. Never commit .env.

# OpenAI (default LLM provider for RCM AI Copilot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_LLM=openai

# Groq (optional — set DEFAULT_LLM=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (optional — set DEFAULT_LLM=ollama and run: ollama serve)
OLLAMA_MODEL=llama3:8b
